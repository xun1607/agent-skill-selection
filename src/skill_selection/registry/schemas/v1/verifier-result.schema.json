{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gr2.local/schemas/v1/verifier-result.schema.json",
  "title": "verifier-result",
  "description": "GR2 v1.0: top-level fields from the 2026-10-22 Google Sheets snapshot; nested details documented in docs/registry/schema-mapping.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error",
        "timeout",
        "invalid_environment"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error",
              "timeout",
              "skipped"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "$ref": "https://gr2.local/schemas/v1/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "task_id",
    "verifier_id",
    "verifier_version",
    "status",
    "checks",
    "evidence_ref",
    "environment_ref",
    "duration_ms",
    "started_at"
  ],
  "additionalProperties": false
}
