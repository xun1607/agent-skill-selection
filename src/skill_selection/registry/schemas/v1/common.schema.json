{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gr2.local/schemas/v1/common.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "condition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "enforcement": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected"
          ]
        }
      },
      "required": [
        "key",
        "op",
        "value",
        "enforcement",
        "evidence",
        "verification_status"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repo_url",
        "path",
        "commit",
        "license"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "enforcement": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "verification_status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name",
        "value",
        "enforcement",
        "verification_status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "skill_id",
        "revision_id",
        "position"
      ],
      "additionalProperties": false
    },
    "skill_revision": {
      "type": "object",
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile_revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "skill_id",
        "revision_id",
        "profile_revision_id"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "truncated": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "content_hash",
        "truncated",
        "text"
      ],
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "repo_url",
        "commit",
        "license"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "elapsed_ms",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "additionalProperties": false
    }
  }
}
