{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gr2.local/schemas/v1/registry-snapshot.schema.json",
  "title": "registry-snapshot",
  "description": "GR2 v1.0: top-level fields from the 2026-10-22 Google Sheets snapshot; nested details documented in docs/registry/schema-mapping.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1.0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "https://gr2.local/schemas/v1/common.schema.json#/$defs/utc"
    },
    "skill_revisions": {
      "type": "array",
      "items": {
        "$ref": "https://gr2.local/schemas/v1/common.schema.json#/$defs/skill_revision"
      }
    },
    "relation_revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "https://gr2.local/schemas/v1/common.schema.json#/$defs/source_ref"
      }
    },
    "status": {
      "enum": [
        "ready",
        "invalid",
        "archived"
      ]
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "skill_revisions",
    "relation_revisions",
    "manifest_hash",
    "source_refs",
    "status"
  ],
  "additionalProperties": false
}
